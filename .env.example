# Copy to .env.local for local development. The anon key is public by design; row-level security guards the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Comma-separated: google,apple (each must be enabled in Supabase first)
VITE_AUTH_PROVIDERS=
# Rutline Pro on the web: Stripe Payment Link and the price shown in the app
VITE_STRIPE_PAYMENT_LINK=
VITE_PRO_PRICE=
# Rutline Pro in the iOS build: RevenueCat public iOS key (appl_...). Without it native builds run fully unlocked.
VITE_REVENUECAT_IOS_KEY=
# Open Pro to everyone on every build while testing; delete it to start selling
VITE_PRO_PREVIEW=
