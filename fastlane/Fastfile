# Rutline iOS lanes. Runs on GitHub's macOS runners; see .github/workflows/ios.yml.
default_platform(:ios)

platform :ios do
  desc "Archive with the installed distribution certificate and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_KEY_ID"),
      issuer_id: ENV.fetch("APPSTORE_ISSUER_ID"),
      key_content: ENV.fetch("APPSTORE_PRIVATE_KEY"),
      is_key_content_base64: true,
      in_house: false
    )

    version = JSON.parse(File.read("../package.json"))["version"]
    increment_version_number(xcodeproj: "ios/App/App.xcodeproj", version_number: version)
    increment_build_number(xcodeproj: "ios/App/App.xcodeproj", build_number: ENV.fetch("BUILD_NUMBER", "1"))

    update_code_signing_settings(
      path: "ios/App/App.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      targets: ["App"],
      code_sign_identity: "Apple Distribution",
      profile_name: ENV.fetch("IOS_PROFILE_NAME"),
      bundle_identifier: "com.jordanyoerger.rutline"
    )

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Rutline.ipa",
      export_options: {
        provisioningProfiles: { "com.jordanyoerger.rutline" => ENV.fetch("IOS_PROFILE_NAME") },
        signingStyle: "manual",
        teamID: ENV.fetch("APPLE_TEAM_ID")
      }
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "build/Rutline.ipa",
      skip_waiting_for_build_processing: true,
      changelog: "Rutline #{version} build #{ENV.fetch("BUILD_NUMBER", "1")}"
    )
  end
end
